CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/Masonry" "${PODS_CONFIGURATION_BUILD_DIR}/SDWebImage" "${PODS_CONFIGURATION_BUILD_DIR}/lottie-ios" "${PODS_ROOT}/../../TKUISDK_iOS/Frameworks" "${PODS_ROOT}/Bugly" "${PODS_ROOT}/MicrosoftCognitiveServicesSpeech-iOS" "${PODS_ROOT}/TKScreenShareService/TKScreenShareService/Frameworks" "${PODS_ROOT}/UMCommon/UMCommon_7.2.5" "${PODS_ROOT}/UMDevice/UMDevice_3.5.0" "${PODS_ROOT}/UMShare/UMShare" "${PODS_ROOT}/UMShare/UMShare/SocialLibraries/QQ/QQSDK" "${PODS_ROOT}/UMShare/UMShare/UMSocialUI" "${PODS_XCFRAMEWORKS_BUILD_DIR}/MicrosoftCognitiveServicesSpeech-iOS" "${PODS_XCFRAMEWORKS_BUILD_DIR}/UMDevice"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/Masonry/Masonry.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/SDWebImage/SDWebImage.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/lottie-ios/Lottie.framework/Headers" "${PODS_ROOT}/Headers/Public" "${PODS_ROOT}/Headers/Public/UMShare"
LD_RUNPATH_SEARCH_PATHS = $(inherited) '@executable_path/Frameworks' '@loader_path/Frameworks'
LIBRARY_SEARCH_PATHS = $(inherited) "${PODS_ROOT}/UMShare/UMShare/SocialLibraries/QQ" "${PODS_ROOT}/UMShare/UMShare/SocialLibraries/Sina" "${PODS_ROOT}/UMShare/UMShare/SocialLibraries/Sina/SinaSDK" "${PODS_ROOT}/UMShare/UMShare/SocialLibraries/WeChat" "${PODS_ROOT}/UMShare/UMShare/SocialLibraries/WeChat/WechatSDK"
OTHER_LDFLAGS = $(inherited) -ObjC -l"SocialOfficialWeChat" -l"SocialQQ" -l"SocialSina" -l"SocialWeChat" -l"WeChatSDK" -l"WeiboSDK" -l"c++" -l"sqlite3" -l"z" -framework "Bugly" -framework "CoreGraphics" -framework "CoreTelephony" -framework "CoreText" -framework "Foundation" -framework "ImageIO" -framework "Lottie" -framework "Masonry" -framework "MicrosoftCognitiveServicesSpeech" -framework "Photos" -framework "QuartzCore" -framework "SDWebImage" -framework "Security" -framework "SystemConfiguration" -framework "TKExtension" -framework "TKLivePlayer" -framework "TKMediaEngine" -framework "TKRoomSDK" -framework "TKScreenShareService" -framework "TKUISDK" -framework "TKWhiteBoard" -framework "TencentOpenAPI" -framework "UIKit" -framework "UMCommon" -framework "UMDevice" -framework "UMShare" -framework "UShareUI" -framework "WebKit"
OTHER_MODULE_VERIFIER_FLAGS = $(inherited) "-F${PODS_CONFIGURATION_BUILD_DIR}/Bugly" "-F${PODS_CONFIGURATION_BUILD_DIR}/Masonry" "-F${PODS_CONFIGURATION_BUILD_DIR}/MicrosoftCognitiveServicesSpeech-iOS" "-F${PODS_CONFIGURATION_BUILD_DIR}/SDWebImage" "-F${PODS_CONFIGURATION_BUILD_DIR}/TKScreenShareService" "-F${PODS_CONFIGURATION_BUILD_DIR}/TKUISDK_iOS" "-F${PODS_CONFIGURATION_BUILD_DIR}/UMCommon" "-F${PODS_CONFIGURATION_BUILD_DIR}/UMDevice" "-F${PODS_CONFIGURATION_BUILD_DIR}/UMShare" "-F${PODS_CONFIGURATION_BUILD_DIR}/lottie-ios"
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
